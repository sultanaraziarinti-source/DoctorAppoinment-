{
  "expo": {
    "name": "DoctorBondhu",
    "slug": "DoctorBondhu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doctorbondhu.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.doctorbondhu.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "DoctorBondhu",
      "shortName": "DoctorBondhu",
      "description": "Book Your Doctor, Stay Healthy",
      "themeColor": "#0B5FD6",
      "backgroundColor": "#F5F8FC",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0B5FD6"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ]
    ]
  }
}
